{
  "name": "bolt-expo-starter",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-apple-scope-diagnostics.mjs",
    "dev": "EXPO_NO_TELEMETRY=1 expo start",
    "build:web": "expo export --platform web",
    "lint": "expo lint --no-cache",
    "typecheck": "tsc --noEmit",
    "expo:check": "expo install --check",
    "doctor": "expo-doctor .",
    "test": "deno test --node-modules-dir=none --no-lock --allow-read --allow-env supabase/functions/_shared/*_test.ts",
    "test:edge": "deno test --node-modules-dir=none --no-lock --allow-read --allow-env supabase/functions/_shared/*_test.ts",
    "test:video": "node scripts/test-webview-video-playback.mjs && node scripts/test-home-video-player.mjs",
    "test:google-login": "node scripts/test-native-google-login.mjs",
    "test:apple-native": "node --test scripts/test-native-apple-login.mjs scripts/test-native-apple-browser-login.mjs scripts/test-apple-scope-diagnostics.mjs",
    "test:member-role": "node --test scripts/test-native-member-role.mjs",
    "test:contact-email": "node --test scripts/test-native-contact-email.mjs scripts/test-native-contact-email-races.mjs",
    "test:session-expiry": "node --test scripts/test-native-session-expiry.mjs",
    "test:auth-keyboard": "node --test scripts/test-native-auth-keyboard.mjs",
    "test:wedding-date": "node --test scripts/test-native-wedding-date-input.mjs",
    "test:bingo-contacts": "node --test scripts/test-native-bingo-contact-profile.mjs scripts/test-native-wedding-date-input.mjs scripts/test-qr-contact-admin-ui.mjs",
    "test:apple-web": "node --test scripts/test-website-apple-sign-in.mjs scripts/test-website-apple-routing.mjs",
    "test:apple-gateway": "node --test scripts/test-app-apple-sign-in-gateway.mjs",
    "audit:production": "node scripts/check-production-audit.mjs",
    "verify": "expo lint --no-cache && tsc --noEmit && expo install --check && expo-doctor . && deno test --node-modules-dir=none --no-lock --allow-read --allow-env supabase/functions/_shared/*_test.ts && node scripts/check-production-audit.mjs && npm run test:video && npm run test:google-login && npm run test:apple-native && npm run test:member-role && npm run test:contact-email && npm run test:session-expiry && npm run test:auth-keyboard && npm run test:apple-web && npm run test:apple-gateway && npm run test:bingo-contacts",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@lucide/lab": "^0.1.2",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@supabase/supabase-js": "^2.58.0",
    "expo": "~54.0.37",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "~7.0.11",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.8",
    "expo-notifications": "^0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "jpeg-js": "^0.4.4",
    "lucide-react-native": "^0.544.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "overrides": {
    "brace-expansion@>=5.0.0 <5.0.9": "5.0.9",
    "postcss": "8.5.26",
    "uuid@<11.1.1": "11.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.0",
    "@php-wasm/cli": "3.1.52",
    "@types/react": "~19.1.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "expo-doctor": "1.20.4",
    "typescript": "~5.9.2"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "unrs-resolver@1.11.1": true
  }
}
