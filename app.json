{
  "expo": {
    "name": "WeddingWin",
    "slug": "weddingwin-app",
    "version": "1.0.0",
    "icon": "./assets/images/app-icon.png",
    "orientation": "portrait",
    "scheme": "weddingwin",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/images/app-icon.png",
      "buildNumber": "1",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "ca.weddingwin.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "WeddingWin uses the camera to scan QR bingo codes at wedding shows.",
        "NSPhotoLibraryUsageDescription": "WeddingWin uses your photo library only when you choose an image to send in a private chat message.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "weddingwin.ca": {
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTPLoads": false,
              "NSExceptionRequiresForwardSecrecy": true
            }
          }
        }
      }
    },
    "android": {
      "package": "ca.weddingwin.app",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-secure-store",
      "expo-notifications",
      "expo-camera",
      "@react-native-community/datetimepicker",
      "expo-audio",
      "expo-asset"
    ],
    "extra": {
      "googleOAuth": {
        "iosClientId": "",
        "webClientId": "655876057326-n28uvus7f20sm5isqc2m9v3jf1o8u196.apps.googleusercontent.com"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
